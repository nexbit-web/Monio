# Neon (pooled) — рантайм приложения и бота
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Neon (direct, без -pooler) — миграции Prisma
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Telegram-бот: создай у @BotFather командой /newbot и вставь токен
TELEGRAM_BOT_TOKEN=

# Только для режима вебхука (хостинг без постоянного процесса): любая длинная случайная строка, A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=

# false — закрыть регистрацию новых пользователей (нужно, если CRM доступна из интернета)
ALLOW_REGISTRATION=true
