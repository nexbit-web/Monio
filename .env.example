# Neon (pooled, адрес с «-pooler») — рантайм CRM и бота. На Vercel — тоже эта переменная
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Neon (direct, без -pooler) — только миграции Prisma с твоего компьютера, на Vercel не нужен
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Telegram-бот: создай у @BotFather командой /newbot и вставь токен
TELEGRAM_BOT_TOKEN=

# Секрет вебхука (бот на Vercel): 32+ случайных символов A-Z a-z 0-9 _ -. Тот же — в переменных Vercel.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=

# Регистрация открыта, только пока в базе нет ни одного аккаунта. true — разрешить новые аккаунты всегда
# (не включай, если CRM доступна из интернета)
ALLOW_REGISTRATION=
