{
	"name": "moneta",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "prisma generate && vite build",
		"preview": "vite preview",
		"bot": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/bot.ts",
		"bot:webhook": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/set-webhook.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:migrate": "prisma migrate dev",
		"db:generate": "prisma generate",
		"db:seed": "prisma db seed",
		"db:studio": "prisma studio",
		"db:deploy": "prisma migrate deploy"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.31.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/pg": "^8.21.0",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"dotenv": "^17.4.2",
		"layerchart": "^2.1.0",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"prisma": "^7.9.1",
		"shadcn-svelte": "^1.5.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.9.1",
		"grammy": "^1.46.0",
		"pg": "^8.23.0",
		"zod": "^4.4.3"
	}
}
